{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		":semanticCommits",
		"mergeConfidence:all-badges"
	],
	"prCreation": "immediate",
	"rebaseWhen": "behind-base-branch",
	"dependencyDashboard": true,
	"labels": [
		"dependencies"
	],
	"packageRules": [
		{
			"matchDepTypes": [
				"*"
			],
			"matchUpdateTypes": [
				"minor",
				"patch"
			],
			"groupName": "backend non-major dependencies",
			"groupSlug": "backend-minor-patch",
			"matchPackageNames": [
				"*"
			],
			"matchFileNames": [
				"backend/**"
			]
		},
		{
			"matchDepTypes": [
				"*"
			],
			"matchUpdateTypes": [
				"major"
			],
			"groupName": "backend major dependencies",
			"groupSlug": "backend-major",
			"matchPackageNames": [
				"*"
			],
			"matchFileNames": [
				"backend/**"
			]
		},
		{
			"matchDepTypes": [
				"dependency-groups.dev"
			],
			"matchUpdateTypes": [
				"minor",
				"patch"
			],
			"groupName": "backend non-major dev dependencies",
			"groupSlug": "backend-dev-minor-patch",
			"matchPackageNames": [
				"*"
			],
			"matchFileNames": [
				"backend/**"
			]
		},
		{
			"matchDepTypes": [
				"dependency-groups.dev"
			],
			"matchUpdateTypes": [
				"major"
			],
			"groupName": "backend major dev dependencies",
			"groupSlug": "backend-dev-major",
			"matchPackageNames": [
				"*"
			],
			"matchFileNames": [
				"backend/**"
			]
		},
		{
			"matchDepTypes": [
				"*"
			],
			"matchUpdateTypes": [
				"minor",
				"patch"
			],
			"groupName": "frontend non-major dependencies",
			"groupSlug": "frontend-minor-patch",
			"matchPackageNames": [
				"*"
			],
			"matchFileNames": [
				"frontend/**"
			]
		},
		{
			"matchDepTypes": [
				"*"
			],
			"matchUpdateTypes": [
				"major"
			],
			"groupName": "frontend major dependencies",
			"groupSlug": "frontend-major",
			"matchPackageNames": [
				"*"
			],
			"matchFileNames": [
				"frontend/**"
			]
		},
		{
			"matchDepTypes": [
				"devDependencies"
			],
			"matchUpdateTypes": [
				"minor",
				"patch"
			],
			"groupName": "frontend non-major dev dependencies",
			"groupSlug": "frontend-dev-minor-patch",
			"matchPackageNames": [
				"*"
			],
			"matchFileNames": [
				"frontend/**"
			]
		},
		{
			"matchDepTypes": [
				"devDependencies"
			],
			"matchUpdateTypes": [
				"major"
			],
			"groupName": "frontend major dev dependencies",
			"groupSlug": "frontend-dev-major",
			"matchPackageNames": [
				"*"
			],
			"matchFileNames": [
				"frontend/**"
			]
		},
		{
			"matchManagers": [
				"github-actions"
			],
			"matchUpdateTypes": [
				"minor",
				"patch"
			],
			"groupName": "workflow non-major dependencies",
			"groupSlug": "workflow-minor-patch",
			"matchPackageNames": [
				"*"
			],
			"matchFileNames": [
				".github/workflows/**"
			]
		},
		{
			"matchManagers": [
				"github-actions"
			],
			"matchUpdateTypes": [
				"major"
			],
			"groupName": "workflow major dependencies",
			"groupSlug": "workflow-major",
			"matchPackageNames": [
				"*"
			],
			"matchFileNames": [
				".github/workflows/**"
			]
		},
		{
			"matchManagers": [
				"github-actions"
			],
			"matchUpdateTypes": [
				"digest"
			],
			"groupName": "workflow digest updates",
			"groupSlug": "workflow-digests",
			"matchPackageNames": [
				"*"
			],
			"matchFileNames": [
				".github/workflows/**"
			]
		},
		{
			"matchFileNames": [
				"frontend/**"
			],
			"labels": [
				"frontend"
			]
		},
		{
			"matchFileNames": [
				"backend/**"
			],
			"labels": [
				"backend"
			]
		},
		{
			"matchFileNames": [
				".github/**"
			],
			"labels": [
				"ci"
			]
		},
		{
			"matchManagers": ["dockerfile", "docker-compose"],
			"matchDatasources": ["docker"],
			"matchUpdateTypes": ["pin", "digest"],
			"pinDigests": true,
			"labels": [
				"docker",
				"dependencies"
			]
		}
	],
	"vulnerabilityAlerts": {
		"groupName": "security updates",
		"groupSlug": "security"
	}
}
